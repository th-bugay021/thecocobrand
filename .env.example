# Paystack: use your test key while developing, then replace it with your live secret key.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Email account used by Nodemailer. For Gmail, use a Google App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
MAIL_FROM="The Coco Brand <your-email@example.com>"
OWNER_EMAIL=owner@example.com

# Where the server listens locally.
PORT=3000
